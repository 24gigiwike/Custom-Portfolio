rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Automatic grandfather grants use this same positive test.
    // A publishing map with status "published" counts.
    // A document with no publishing field and published == true counts.
    // An explicit draft does not. Any other publishing shape is not published here;
    // the planner sends those records to manual review instead of granting.
    // A non-empty selectedTemplate is the permanent choice.
    // Later updates may edit content, but they may not replace that id.
    // A missing or blank value can still be set once.
    function templateSelectionLocked() {
      return resource.data.keys().hasAny(["selectedTemplate"])
        && resource.data.selectedTemplate is string
        && resource.data.selectedTemplate.size() > 0;
    }

    function portfolioIsPublished(data) {
      return data.keys().hasAny(["publishing"])
        ? data.publishing is map && data.publishing.get("status", "") == "published"
        : data.keys().hasAny(["published"]) && data.published == true;
    }

    // Server-only switch at publishingControls/gate.
    // A new publication requires this document to exist and enabled to be exactly true.
    // A missing document, a rules read error, or any other value blocks that publication.
    // Clients cannot write this document. Rules cannot read environment variables.
    function publishingGateEnabled() {
      return exists(/databases/$(database)/documents/publishingControls/gate)
        && get(/databases/$(database)/documents/publishingControls/gate).data.enabled == true;
    }

    // Historical publishingEntitlements/{uid} stays readable by its owner.
    // It does not authorize a new publication. A new publication reads
    // portfolioPublishingEntitlements/{portfolioId} for this portfolio only.
    // A missing expiresAt keeps a grandfathered record valid.
    // A present expiresAt must be a timestamp strictly after request.time.
    // Null, a string, or any other value does not authorize publication.
    function portfolioEntitlementExpiryAllowsPublication(data) {
      return !data.keys().hasAny(["expiresAt"])
        || (data.expiresAt is timestamp && data.expiresAt > request.time);
    }

    function hasActivePortfolioPublishingEntitlement(portfolioId) {
      return exists(/databases/$(database)/documents/portfolioPublishingEntitlements/$(portfolioId))
        && get(/databases/$(database)/documents/portfolioPublishingEntitlements/$(portfolioId)).data.portfolioId == portfolioId
        && get(/databases/$(database)/documents/portfolioPublishingEntitlements/$(portfolioId)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/portfolioPublishingEntitlements/$(portfolioId)).data.status == "active"
        && portfolioEntitlementExpiryAllowsPublication(
          get(/databases/$(database)/documents/portfolioPublishingEntitlements/$(portfolioId)).data
        );
    }

    // A draft becomes published only when the gate is enabled and this portfolio
    // has an active entitlement. An already stored published document may still
    // be saved. Create has no resource, so that branch must not read resource.data.
    // && short-circuits: a missing gate or entitlement is not read, and a thrown
    // get() denies the write.
    function mayBecomePublished(portfolioId) {
      return resource != null && portfolioIsPublished(resource.data)
        ? true
        : publishingGateEnabled() && hasActivePortfolioPublishingEntitlement(portfolioId);
    }

    function isReservedSlug(slug) {
      return slug in [
        "about", "account", "accounts", "admin", "administrator", "api", "app", "assets",
        "auth", "billing", "blog", "broadbrand", "cdn", "contact", "copy", "create",
        "customportfolio", "dashboard", "delete", "demo", "design", "dev", "development",
        "discover", "docs", "documentation", "download", "downloads", "draft", "edit",
        "email", "favicon", "files", "firebase", "google", "health", "help", "home",
        "index", "legal", "login", "logout", "mail", "me", "moderator", "new", "null",
        "onboarding", "overview", "owner", "owners", "portfolio", "preview", "pricing",
        "privacy", "private", "production", "public", "publish", "register", "review",
        "robots", "root", "save", "seo", "settings", "sign-in", "sign-out", "signin",
        "signout", "signup", "sitemap", "staging", "static", "status", "support",
        "system", "template", "template-preview", "templates", "terms", "test",
        "undefined", "unpublish", "update", "upload", "uploads", "user", "users",
        "webmaster", "well-known", "workspace", "www"
      ];
    }

    // User account document rules
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Portfolio document rules. Anonymous reads stay denied, including after publication.
    match /portfolios/{portfolioId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      // Portfolio documents are created by the trusted server, which bypasses these rules.
      // A signed-in client cannot create one, including a second portfolio for a new account.
      allow create: if false;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && (!portfolioIsPublished(request.resource.data) || mayBecomePublished(portfolioId))
        && (!templateSelectionLocked() || request.resource.data.selectedTemplate == resource.data.selectedTemplate);
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && !templateSelectionLocked();

      // Projects subcollection rules.
      // Writes require the signed-in user to own the parent portfolio.
      match /projects/{projectId} {
        function parentOwnerId() {
          return get(/databases/$(database)/documents/portfolios/$(portfolioId)).data.ownerId;
        }

        allow read: if isSignedIn() && (
          request.auth.uid == parentOwnerId() ||
          (resource != null && resource.data.ownerId == request.auth.uid)
        );
        allow create: if isSignedIn() && request.auth.uid == parentOwnerId();
        allow update, delete: if isSignedIn() && request.auth.uid == parentOwnerId();
      }
    }

    // Public presentation. The document id is the private portfolio id.
    // Rules read the private portfolio only to check ownership and publication.
    // They do not make that private document readable.
    match /publicPortfolios/{publicId} {
      function privatePortfolioAfter() {
        return getAfter(/databases/$(database)/documents/portfolios/$(publicId));
      }

      function privatePortfolio() {
        return get(/databases/$(database)/documents/portfolios/$(publicId));
      }

      function isPublished(portfolioData) {
        return portfolioData.keys().hasAny(["publishing"])
          ? portfolioData.publishing.status == "published"
          : portfolioData.published == true;
      }

      function presentationKeys() {
        return [
          "publicId",
          "selectedTemplate",
          "profile",
          "socialLinks",
          "projects",
          "contact",
          "seo",
          "discoverability",
          "design",
          "publicSlug",
          "publishedAt",
          "updatedAt"
        ];
      }

      function activeSlugRecord(slug) {
        return getAfter(/databases/$(database)/documents/portfolioSlugs/$(slug));
      }

      function explicitLegacyEntitlement(data) {
        return data.status == "active"
          && data.source == "grandfathered"
          && data.grantReason == "published-before-payment-gate"
          && !data.keys().hasAny(["expiresAt"]);
      }

      function publicEntitlementRecord(data, portfolioId) {
        return data.uid == privatePortfolio().data.ownerId
          && data.portfolioId == portfolioId
          && data.status == "active"
          && (
            explicitLegacyEntitlement(data)
            || (
              data.keys().hasAny(["expiresAt"])
              && data.expiresAt is timestamp
              && request.time < data.expiresAt + duration.time(168, 0, 0, 0)
            )
          );
      }

      function entitlementAllowsPublicRead(portfolioId) {
        let path = /databases/$(database)/documents/portfolioPublishingEntitlements/$(portfolioId);
        return exists(path) && publicEntitlementRecord(get(path).data, portfolioId);
      }

      allow read: if resource.data.publicId == publicId
        && isPublished(privatePortfolio().data)
        && entitlementAllowsPublicRead(publicId);

      allow create, update: if isSignedIn()
        && privatePortfolioAfter().data.ownerId == request.auth.uid
        && isPublished(privatePortfolioAfter().data)
        && request.resource.data.publicId == publicId
        && request.resource.data.keys().hasOnly(presentationKeys())
        && request.resource.data.selectedTemplate is string
        && (
          !privatePortfolioAfter().data.keys().hasAny(["selectedTemplate"])
          || !(privatePortfolioAfter().data.selectedTemplate is string)
          || privatePortfolioAfter().data.selectedTemplate.size() == 0
          || request.resource.data.selectedTemplate == privatePortfolioAfter().data.selectedTemplate
        )
        && request.resource.data.profile is map
        && request.resource.data.profile.keys().hasOnly([
          "brandName", "logo", "heroImage", "heroImageMobile", "headline",
          "capabilityTags", "ctaLabel", "ctaHref", "email"
        ])
        && request.resource.data.socialLinks is list
        && request.resource.data.projects is list
        && request.resource.data.contact is map
        && request.resource.data.contact.keys().hasOnly([
          "email", "eyebrow", "heading", "description", "projectTypes", "formEndpoint"
        ])
        && request.resource.data.seo is map
        && request.resource.data.seo.keys().hasOnly([
          "title", "description", "canonicalUrl", "ogTitle", "ogDescription",
          "ogImage", "twitterTitle", "twitterDescription", "twitterImage"
        ])
        && (
          !("discoverability" in request.resource.data)
          || (
            request.resource.data.discoverability is map
            && request.resource.data.discoverability.keys().hasOnly(["identity", "serviceRegion", "faqs"])
            && request.resource.data.discoverability.identity in ["", "person", "organization"]
            && request.resource.data.discoverability.serviceRegion is string
            && request.resource.data.discoverability.serviceRegion.size() <= 120
            && request.resource.data.discoverability.faqs is list
            && request.resource.data.discoverability.faqs.size() <= 8
          )
        )
        && (
          !("publicSlug" in request.resource.data)
          || (
            request.resource.data.publicSlug is string
            && request.resource.data.publicSlug.size() <= 48
            && (
              request.resource.data.publicSlug == ""
              || (
                request.resource.data.publicSlug.size() >= 3
                && request.resource.data.publicSlug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
                && request.resource.data.publicSlug == privatePortfolioAfter().data.publicSlug
                && activeSlugRecord(request.resource.data.publicSlug).data.role == "active"
                && activeSlugRecord(request.resource.data.publicSlug).data.portfolioId == publicId
              )
            )
          )
        )
        && request.resource.data.design is map
        && request.resource.data.design.keys().hasOnly(["palette"])
        && request.resource.data.updatedAt == request.time
        && (
          request.resource.data.publishedAt == null
          || request.resource.data.publishedAt is timestamp
          || request.resource.data.publishedAt is string
        );

      allow delete: if isSignedIn()
        && privatePortfolioAfter().data.ownerId == request.auth.uid
        && !isPublished(privatePortfolioAfter().data);
    }

    // Public URL list for the sitemap. Entries exist only while a portfolio is published.
    // The document stores the public id and nothing about the owner account.
    match /sitemapEntries/{publicId} {
      function privatePortfolioAfter() {
        return getAfter(/databases/$(database)/documents/portfolios/$(publicId));
      }

      function isPublished(portfolioData) {
        return portfolioData.keys().hasAny(["publishing"])
          ? portfolioData.publishing.status == "published"
          : portfolioData.published == true;
      }

      allow read: if true;

      allow create, update: if isSignedIn()
        && privatePortfolioAfter().data.ownerId == request.auth.uid
        && isPublished(privatePortfolioAfter().data)
        && request.resource.data.keys().hasOnly(["publicId", "updatedAt", "slug"])
        && request.resource.data.publicId == publicId
        && request.resource.data.updatedAt == request.time
        && (
          !("slug" in request.resource.data)
          || request.resource.data.slug == (
            privatePortfolioAfter().data.keys().hasAny(["publicSlug"])
              ? privatePortfolioAfter().data.publicSlug
              : ""
          )
        );

      allow delete: if isSignedIn()
        && privatePortfolioAfter().data.ownerId == request.auth.uid
        && !isPublished(privatePortfolioAfter().data);
    }

    // Permanent portfolio ids. The document stores the id and nothing about the owner.
    // Signed-in clients may read one id while claiming a slug. Listing the collection is denied.
    match /portfolioIds/{portfolioId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(["portfolioId"])
        && request.resource.data.portfolioId == portfolioId
        && getAfter(/databases/$(database)/documents/portfolios/$(portfolioId)).data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // One slug belongs to one portfolio. The document does not store the owner account.
    // Anonymous reads succeed only while that portfolio is published.
    match /portfolioSlugs/{slug} {
      function portfolioAfter() {
        return getAfter(/databases/$(database)/documents/portfolios/$(request.resource.data.portfolioId));
      }

      function portfolioNow() {
        return get(/databases/$(database)/documents/portfolios/$(resource.data.portfolioId));
      }

      function isPublished(portfolioData) {
        return portfolioData.keys().hasAny(["publishing"])
          ? portfolioData.publishing.status == "published"
          : portfolioData.published == true;
      }

      function slugShape() {
        return slug.size() >= 3
          && slug.size() <= 48
          && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
          && !isReservedSlug(slug);
      }

      // A missing slug has no document. Signed-in clients must be able to read that
      // absence, or every unused address looks like a permissions failure.
      // A signed-in read of an existing slug confirms a collision. The record stores
      // the portfolio id and role only. Listing stays denied.
      // Anonymous reads still require the portfolio to be published.
      allow get: if isSignedIn()
        || (
          resource != null
          && resource.data.portfolioId is string
          && exists(/databases/$(database)/documents/publicPortfolios/$(resource.data.portfolioId))
          && isPublished(portfolioNow().data)
        );
      allow list: if false;

      allow create: if isSignedIn()
        && slugShape()
        && request.resource.data.keys().hasOnly(["slug", "portfolioId", "role"])
        && request.resource.data.slug == slug
        && request.resource.data.role == "active"
        && request.resource.data.portfolioId is string
        && request.resource.data.portfolioId.size() > 0
        && request.resource.data.portfolioId.size() <= 128
        && portfolioAfter().data.ownerId == request.auth.uid
        && portfolioAfter().data.publicSlug == slug
        && portfolioAfter().data.publicSlugAliases is list
        && portfolioAfter().data.publicSlugAliases.size() <= 8
        && !exists(/databases/$(database)/documents/portfolios/$(slug))
        && !exists(/databases/$(database)/documents/portfolioIds/$(slug));

      allow update: if isSignedIn()
        && slugShape()
        && resource.data.portfolioId == request.resource.data.portfolioId
        && resource.data.slug == slug
        && request.resource.data.keys().hasOnly(["slug", "portfolioId", "role"])
        && request.resource.data.slug == slug
        && request.resource.data.role in ["active", "alias"]
        && portfolioAfter().data.ownerId == request.auth.uid
        && portfolioAfter().data.publicSlugAliases is list
        && portfolioAfter().data.publicSlugAliases.size() <= 8
        && (
          (
            request.resource.data.role == "active"
            && portfolioAfter().data.publicSlug == slug
          )
          || (
            request.resource.data.role == "alias"
            && portfolioAfter().data.publicSlug != slug
            && slug in portfolioAfter().data.publicSlugAliases
          )
        );

      allow delete: if false;
    }

    // Historical account publishing right. The Admin SDK created it.
    // The owner may read their own record. Clients cannot create, change, or delete it.
    // It does not authorize publishing a portfolio.
    match /publishingEntitlements/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Publishing right for one portfolio. The Admin SDK grants it after a verified payment
    // or an approved association with the one portfolio already published under an older right.
    // The owner may read it. Clients cannot create, change, or delete it.
    // Unpublishing does not match this document, so the right remains.
    match /portfolioPublishingEntitlements/{portfolioId} {
      allow get: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.portfolioId == portfolioId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Payment facts for a future verified charge. No checkout writes these.
    // The owner may read one of their own records. Clients cannot write them.
    match /payments/{paymentId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Publishing gate. Clients cannot read or write it.
    // A missing document, or any value other than enabled == true, blocks a new publication.
    match /publishingControls/{document} {
      allow read, write: if false;
    }

    // Historical account lock documents. Clients cannot read or write them.
    // Creating a portfolio does not read or write this collection.
    match /accountPortfolios/{uid} {
      allow read, write: if false;
    }

    // Creation request ids. Only the trusted server writes them, inside the create transaction.
    match /portfolioCreateRequests/{uid} {
      allow read, write: if false;
      match /items/{requestId} {
        allow read, write: if false;
      }
    }

    // Domain orders. The owner may read one of their own orders.
    // Clients cannot create or change payment, registrar, or provisioning facts.
    match /domainOrders/{orderId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /domainRegistrations/{orderId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /domainProvisioning/{orderId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /domainLifecycleEvents/{orderId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Registrant contact details and hostname routing records are server-only.
    match /domainRegistrants/{orderId} {
      allow read, write: if false;
    }

    match /domainHostnames/{hostname} {
      allow read, write: if false;
    }

    match /domainPaymentHolds/{paymentId} {
      allow read, write: if false;
    }

    // Sandbox webhook receipts are server-only. They are not entitlements.
    match /sandboxWebhookReceipts/{eventId} {
      allow read, write: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

