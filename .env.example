# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Authentication (Optional Custom Config)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Vercel → Project Settings → Environment Variables.
# Name: VITE_BROADBRAND_SUPPORT_WHATSAPP
# Value: 2347060706416
# Apply it to Production. Add Preview as well if that link should appear on preview builds.
# Vite reads VITE_ variables when the site is built, so redeploy after saving the variable.
# Contact Support opens https://wa.me/2347060706416 with a prefilled message. It does not send the message.
# Leave the variable empty to hide the link. Do not put a customer's number here.
VITE_BROADBRAND_SUPPORT_WHATSAPP=2347060706416

# Image compression backend. Vite reads this when the site is built, so change it in
# Vercel → Project Settings → Environment Variables and redeploy.
# browser — browser-image-compression in a same-origin Web Worker (default when unset)
# legacy — the previous canvas optimizer, and no browser-image-compression work
# Name: VITE_IMAGE_COMPRESSION_BACKEND
# Value: browser
VITE_IMAGE_COMPRESSION_BACKEND=browser

# Upload timing logs. Leave unset in production.
# 1 or true prints stage timings. 0 or false forces them off, including during local dev.
# Logs include byte counts, durations, and Firebase error codes. They do not include tokens,
# download URLs, file names, image contents, or contact details.
# VITE_IMAGE_UPLOAD_DEBUG=1

# Image storage. Vite reads VITE_IMAGE_STORAGE_PROVIDER when the site is built.
# firebase — current uploads (default when unset). This is the rollback.
# imagekit — account photo proof only. Existing portfolio portrait, logo, social,
# and project uploads still use Firebase until later steps switch them explicitly.
# Name: VITE_IMAGE_STORAGE_PROVIDER
# Value: firebase
VITE_IMAGE_STORAGE_PROVIDER=firebase

# ImageKit server credentials. Do not prefix the private key with VITE_.
# It must never be bundled into the browser, and it must never be committed.
#
# Cloud agents: Cursor Dashboard -> Cloud Agents -> Secrets.
#   IMAGEKIT_PRIVATE_KEY   type: Runtime Secret
#   IMAGEKIT_PUBLIC_KEY    type: Environment Variable
#   IMAGEKIT_URL_ENDPOINT  type: Environment Variable
# Secrets are injected when an agent starts. Start a new agent after saving them.
# A gitignored .env.local is also read by the Vite dev server. Do not commit that file.
#
# Production: Vercel → Project Settings → Environment Variables, same three names.
# IMAGEKIT_PRIVATE_KEY=  private API key. Server only. Never returned to the client.
# IMAGEKIT_PUBLIC_KEY=   public API key. Required with the private key and URL endpoint.
#                         The server upload does not send it back to the browser.
# IMAGEKIT_URL_ENDPOINT= https://ik.imagekit.io/your_imagekit_id
#
# POST /api/imagekit-upload checks a Firebase ID token and the file bytes, then
# uploads with the private key. The browser cannot choose the folder, file name,
# or overwrite flag. The optimized file must be JPEG, PNG, WebP, or GIF and at
# most 2 MiB, which is the largest file the current optimizer will emit.
# Vercel’s function body limit is 4.5 MB. This route caps the request lower.
#
# Production stays closed until IMAGEKIT_UPLOAD_ALLOW_UIDS lists Firebase uids,
# comma-separated. That name is server-only. An empty value rejects every upload.
# The Vite dev server enables the proof in code. A public VITE_ variable cannot.
# IMAGEKIT_UPLOAD_ALLOW_UIDS=
#
# Firebase Admin is required for durable ImageKit quota and lifecycle records.
# Keep these server-only. Do not prefix them with VITE_ and do not commit values.
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
#
# Optional. Defaults to 26214400 bytes (25 MiB) per Firebase uid.
# IMAGEKIT_DEFAULT_ACCOUNT_QUOTA_BYTES=26214400
#
# Durable per-user byte quotas are active only for this server-mediated ImageKit
# route. Product image fields still use Firebase Storage until a later step.
# Each upload request runs best-effort stale-reservation reconciliation for that
# uid. A manual admin tool can call the same server primitive; no paid scheduler
# is required, and uncertain ImageKit outcomes keep quota reserved until deletion
# or operator-verified absence.
# The retired /api/imagekit-auth route no longer signs browser uploads.
# FIREBASE_PROJECT_ID is optional. When unset, tokens are checked for custom-portfolio-2026.
