# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase web configuration. Names only. Put real project values in gitignored
# .env.local or in the Vercel environment. Do not commit keys.
#
# The six VITE_FIREBASE_* values are public client configuration. They identify
# a Firebase project. They are not private credentials.
# FIREBASE_ADMIN_PRIVATE_KEY, API secrets, webhook secrets, and registrar keys
# are private and must never use a VITE_ prefix.
#
# Local sandbox runs against the emulators, not a cloud project.
# Put the public demo web config in gitignored .env.development.local so
# production builds do not load it:
# VITE_FIREBASE_API_KEY=demo-custom-portfolio-web-key
# VITE_FIREBASE_AUTH_DOMAIN=demo-custom-portfolio.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=demo-custom-portfolio
# VITE_FIREBASE_STORAGE_BUCKET=demo-custom-portfolio.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
# VITE_FIREBASE_APP_ID=1:000000000000:web:democustomportfolio
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Keep these server values in .env.local:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=demo-custom-portfolio
# Do not point sandbox payments at custom-portfolio-2026.
# Production runtime remains custom-portfolio-2026.
#
# Vercel Preview requires all six VITE_FIREBASE_* names for custom-by-broadbrand.
# An empty set does not fall back to production outside Vercel Production.
# Vercel Production may leave all six empty to use the committed
# custom-portfolio-2026 web config, or set all six to that same project.
# A partial set is rejected. Do not set VERCEL_ENV in an env file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server token audience. Must match VITE_FIREBASE_PROJECT_ID when both are set.
# Local and Preview: custom-by-broadbrand
# Vercel Production: custom-portfolio-2026 when unset.
# FIREBASE_PROJECT_ID=

# Vercel → Project Settings → Environment Variables.
# Name: VITE_BROADBRAND_SUPPORT_WHATSAPP
# Value: 2347060706416
# Apply it to Production. Add Preview as well if that link should appear on preview builds.
# Vite reads VITE_ variables when the site is built, so redeploy after saving the variable.
# Contact Support opens https://wa.me/2347060706416 with a prefilled message. It does not send the message.
# Leave the variable empty to hide the link. Do not put a customer's number here.
VITE_BROADBRAND_SUPPORT_WHATSAPP=2347060706416

# Image compression backend. Vite reads this when the site is built, so change it in
# Vercel → Project Settings → Environment Variables and redeploy.
# browser — browser-image-compression in a same-origin Web Worker (default when unset)
# legacy — the previous canvas optimizer, and no browser-image-compression work
# Name: VITE_IMAGE_COMPRESSION_BACKEND
# Value: browser
VITE_IMAGE_COMPRESSION_BACKEND=browser

# Upload timing logs. Leave unset in production.
# 1 or true prints stage timings. 0 or false forces them off, including during local dev.
# Logs include byte counts, durations, and Firebase error codes. They do not include tokens,
# download URLs, file names, image contents, or contact details.
# VITE_IMAGE_UPLOAD_DEBUG=1

# Image storage. Vite reads VITE_IMAGE_STORAGE_PROVIDER when the site is built.
# firebase — current uploads (default when unset). This is the rollback.
# imagekit — account photo proof only. Existing portfolio portrait, logo, social,
# and project uploads still use Firebase until later steps switch them explicitly.
# Name: VITE_IMAGE_STORAGE_PROVIDER
# Value: firebase
VITE_IMAGE_STORAGE_PROVIDER=firebase

# ImageKit server credentials. Do not prefix the private key with VITE_.
# It must never be bundled into the browser, and it must never be committed.
#
# Cloud agents: Cursor Dashboard -> Cloud Agents -> Secrets.
#   IMAGEKIT_PRIVATE_KEY   type: Runtime Secret
#   IMAGEKIT_PUBLIC_KEY    type: Environment Variable
#   IMAGEKIT_URL_ENDPOINT  type: Environment Variable
# Secrets are injected when an agent starts. Start a new agent after saving them.
# A gitignored .env.local is also read by the Vite dev server. Do not commit that file.
#
# Production: Vercel → Project Settings → Environment Variables, same three names.
# IMAGEKIT_PRIVATE_KEY=  private API key. Server only. Never returned to the client.
# IMAGEKIT_PUBLIC_KEY=   public API key. Required with the private key and URL endpoint.
#                         The server upload does not send it back to the browser.
# IMAGEKIT_URL_ENDPOINT= https://ik.imagekit.io/your_imagekit_id
#
# POST /api/imagekit-upload checks a Firebase ID token and the file bytes, then
# uploads with the private key. The browser cannot choose the folder, file name,
# or overwrite flag. The optimized file must be JPEG, PNG, WebP, or GIF and at
# most 2 MiB, which is the largest file the current optimizer will emit.
# Vercel’s function body limit is 4.5 MB. This route caps the request lower.
#
# Production stays closed until IMAGEKIT_UPLOAD_ALLOW_UIDS lists Firebase uids,
# comma-separated. That name is server-only. An empty value rejects every upload.
# The Vite dev server enables the proof in code. A public VITE_ variable cannot.
# IMAGEKIT_UPLOAD_ALLOW_UIDS=
#
# Firebase Admin is required for durable ImageKit quota and lifecycle records.
# Keep these server-only. Do not prefix them with VITE_ and do not commit values.
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
#
# Bachs credentials. Server only. Do not prefix these names with VITE_.
# Do not commit values. Local and Preview use a sandbox key. Production uses a live key.
# A sandbox product id and webhook secret are not reused in production.
# BACHS_API_KEY=
# BACHS_WEBHOOK_SECRET=
# BACHS_PUBLISHING_PRODUCT_ID=
# Public https return URLs for hosted checkout. Localhost is rejected.
# Use the public host with these paths and no query string. Bachs adds checkout_id.
# Success path: /portfolio/publish/return
# Cancellation path: /portfolio/publish/cancelled
# A missing or invalid value stops checkout before a Bachs session is created.
# The success URL does not grant publishing.
# BACHS_PUBLISHING_SUCCESS_URL=
# BACHS_PUBLISHING_CANCEL_URL=
#
# Optional. Defaults to 26214400 bytes (25 MiB) per Firebase uid.
# IMAGEKIT_DEFAULT_ACCOUNT_QUOTA_BYTES=26214400
#
# Durable per-user byte quotas are active only for this server-mediated ImageKit
# route. Product image fields still use Firebase Storage until a later step.
# Each upload request runs best-effort stale-reservation reconciliation for that
# uid. A manual admin tool can call the same server primitive; no paid scheduler
# is required, and uncertain ImageKit outcomes keep quota reserved until deletion
# or operator-verified absence.
# The retired /api/imagekit-auth route no longer signs browser uploads.
# Outside Vercel Production, FIREBASE_PROJECT_ID or VITE_FIREBASE_PROJECT_ID
# must be custom-by-broadbrand. There is no silent production fallback.
#
# DomainNameAPI OTE. Server only. Do not prefix these names with VITE_.
# DNA_API_BASE must be https://ote.domainresellerapi.com. The live host is rejected.
# DNA_ALLOW_REGISTRATION=ote is required before a registration call. Search does not register.
# DOMAIN_MARKUP_BASIS_POINTS is an integer from 0 to 10000. 250 means 2.50 percent.
# DNA_API_BASE=
# DNA_API_KEY=
# DNA_RESELLER_ID=
# DNA_ALLOW_REGISTRATION=
# DOMAINNAMEAPI_ENV is accepted when DNA_API_BASE is empty. The live host is still rejected.
# DOMAINNAMEAPI_ENV=
# DOMAIN_NAME_API_OTE_KEY=
# DOMAIN_NAME_API_OTE_RESELLER_ID=
# DOMAINNAMEAPI_API_KEY=
# DOMAIN_MARKUP_BASIS_POINTS=
# USD registrar prices need a fresh Open Exchange Rates USD to NGN rate. No rate is built in.
# Set EXCHANGE_RATE_PROVIDER=openexchangerates and OPEN_EXCHANGE_RATES_APP_ID from an Open Exchange Rates account.
# Rates older than EXCHANGE_RATE_MAX_AGE_SECONDS are rejected. The default maximum age is 6 hours, capped at 24 hours.
# DOMAIN_QUOTE_TTL_SECONDS locks the approved naira amount. The default is 15 minutes, capped at 60 minutes.
# EXCHANGE_RATE_PROVIDER=
# OPEN_EXCHANGE_RATES_APP_ID=
# EXCHANGE_RATE_MAX_AGE_SECONDS=
# DOMAIN_QUOTE_TTL_SECONDS=
# Local sandbox Firestore. These values must not point at custom-portfolio-2026.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-custom-portfolio
# VITE_FIREBASE_PROJECT_ID=demo-custom-portfolio
# Hosted webhook: https://customportfolio.broadbrand.com.ng/api/bachs-webhook
# BACHS_WEBHOOK_SECRET verifies live events. Do not replace it with the sandbox secret.
# BACHS_SANDBOX_WEBHOOK_SECRET verifies sandbox events on that same URL.
# BACHS_SANDBOX_API_KEY must be an sk_sandbox_ key and must not be the live API key.
# A sandbox-signed event is stored as a receipt and does not grant publishing or register a domain.
# BACHS_SANDBOX_WEBHOOK_SECRET=
# BACHS_SANDBOX_API_KEY=
# BACHS_SANDBOX_DOMAIN_PRODUCT_ID=
# Separate from the publishing product. Leave empty until the Bachs dashboard has a domain product.
# Do not reuse the publishing product id. No default is implied.
# BACHS_DOMAIN_PRODUCT_ID=
#
# Domain routing uses the existing Vercel project. Cloudflare is DNS only.
# Copy VERCEL_APEX_IPV4 and VERCEL_CNAME_TARGET from this project's Domains page.
# Do not use a vercel.app hostname as the CNAME target. Do not set a fallback origin.
# CLOUDFLARE_DNS_WRITES=local-sandbox and VERCEL_DOMAIN_WRITES=local-sandbox arm local tests only.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DNS_WRITES=
# VERCEL_APEX_IPV4=
# VERCEL_CNAME_TARGET=
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# VERCEL_DOMAIN_WRITES=
# BACHS_DOMAIN_SUCCESS_URL=
# BACHS_DOMAIN_CANCEL_URL=
